{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "analisador-instagram",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  /*
   * Segredos (IG_ACCESS_TOKEN, OPENAI_API_KEY, OPENAI_MODEL opcional) NÃO vão
   * aqui: configure no painel — Worker → Settings → Variables and Secrets —
   * ou via `npx wrangler secret put NOME`. Nunca commite tokens.
   */
}
